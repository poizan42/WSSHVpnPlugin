<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Plain net10.0 on purpose: no WinRT, no UWP, no platform. The user-space TCP/IP stack is the
      most testable part of this project and the plug-in is the least, so it lives where `dotnet
      test` can run it in a second rather than needing a package deploy and a VPN activation.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <!--
      Needed even though nothing here is platform-specific: the plug-in publishes Native AOT per RID,
      and a referenced library without matching identifiers fails the packaging build with
      NETSDK1047. The fork carries the same property for the same reason.
    -->
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
