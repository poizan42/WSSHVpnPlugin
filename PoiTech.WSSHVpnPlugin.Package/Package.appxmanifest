<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp rescap">

  <Identity
    Name="3703e6b2-f1f9-447d-b506-da47be3094ff"
    Publisher="CN=poizan"
    Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="3703e6b2-f1f9-447d-b506-da47be3094ff" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>PoiTech.WSSHVpnPlugin.App.Package</DisplayName>
    <PublisherDisplayName>poizan</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 20348 is where AppendVpnReceivePacketBuffer / FlushVpnReceivePacketBuffers appear. -->
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.20348.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="PoiTech.WSSHVpnPlugin.App\PoiTech.WSSHVpnPlugin.App.exe"
      EntryPoint="PoiTech.WSSHVpnPlugin.App.App">
      <uap:VisualElements
        DisplayName="SSH VPN"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="VPN over SSH tunnelling"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>

    <!--
      The VPN plug-in is hosted by its own application entry so the platform can activate it
      without the UI app. AppListEntry="none" keeps it out of the Start menu.
    -->
    <Application Id="Plugin">
      <uap:VisualElements
        DisplayName="SSH VPN Plug-in"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="VPN over SSH tunnelling"
        BackgroundColor="transparent"
        AppListEntry="none">
        <uap:DefaultTile />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!--
          Executable is mandatory and must be the plug-in's own host, not the UI app's. Omitting it
          so that backgroundtaskhost.exe would host the task fails registration with 0x80080204,
          "a task of this type requires a custom background task host" - a vpnClient task must name
          a host binary. Naming the UI app's executable is what used to put the tunnel inside a XAML
          application's process, where suspension forced a GC that deadlocked and killed the host
          about a minute after every connect.
        -->
        <Extension Category="windows.backgroundTasks"
                   Executable="PoiTech.WSSHVpnPlugin.VpnPlugin\PoiTech.WSSHVpnPlugin.VpnPlugin.exe"
                   EntryPoint="PoiTech.WSSHVpnPlugin.VpnPlugin.VpnBackgroundTask">
          <BackgroundTasks>
            <uap:Task Type="vpnClient" />
            <!--
              AssociateTransport registers the outer tunnel transport as a ControlChannelTrigger, and
              Start* then calls WaitForPushEnabled on it, which fails here with a denial from the
              trigger broker. Declaring the controlChannel task type is what entitles a package to
              hold a control channel at all. Maple ships without it, so this may not be the cause -
              but the declaration is free and the failure is inside that subsystem.
            -->
            <Task Type="controlChannel" />
          </BackgroundTasks>
        </Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <uap:Capability Name="sharedUserCertificates" />
    <!--
      Restricted capability. Sideloading works, but Store submission needs Microsoft approval,
      and the package must be signed for the machine to accept it.
    -->
    <rescap:Capability Name="networkingVpnProvider" />
    <!--
      Needed only to read a private key from a path outside the package, since the plug-in runs in
      an app container. If key handling later moves into the package's own local folder, or to a
      certificate via RequestCredentials, this can go.
    -->
    <rescap:Capability Name="broadFileSystemAccess" />
    <!--
      Restricted capability: lifts background task execution time limits. The activation that
      carries a connection lives as long as the connection, and its execution allowance is consumed
      by the tunnel's own CPU: measured twice, the platform cancelled it with ExecutionTimeExceeded
      after 2-3 minutes of 140 Mbit/s or ~13 minutes of lighter traffic, could not get the
      connection-long task to complete in response, and executed the host mid-download - the
      "dead replacement host" pattern. A cancel of that instance is unanswerable by design, so the
      only fix is for the limit not to apply.
    -->
    <rescap:Capability Name="extendedBackgroundTaskTime" />
  </Capabilities>

  <Extensions>
    <!--
      Package-level WinRT activation registration for the background task. Without it the
      packaging step fails with "not allowed to have EntryPoint=... without ActivatableClassId in
      windows.activatableClass.inProcessServer".

      Path names the binary that exports DllGetActivationFactory. Under .NET Native that was
      CLRHost.dll; here it is the plug-in's own executable, which is also its background task host.
      It used to name the app's executable, because the component was linked into it - which is what
      made the VPN host share a process with a XAML application, and what killed the tunnel about a
      minute after every connect.
    -->
    <Extension Category="windows.activatableClass.inProcessServer">
      <InProcessServer>
        <Path>PoiTech.WSSHVpnPlugin.VpnPlugin\PoiTech.WSSHVpnPlugin.VpnPlugin.exe</Path>
        <ActivatableClass ActivatableClassId="PoiTech.WSSHVpnPlugin.VpnPlugin.VpnBackgroundTask" ThreadingModel="both" />
      </InProcessServer>
    </Extension>
  </Extensions>
</Package>
