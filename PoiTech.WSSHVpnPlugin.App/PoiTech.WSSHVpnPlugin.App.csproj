<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Follows the plug-in; see the comment in PoiTech.WSSHVpnPlugin.VpnPlugin.csproj. -->
    <TargetPlatformMinVersion>10.0.20348.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Needed even though this project authors no WinRT types: CsWinRT's targets are what strip the
      referenced component's .winmd out of the compile references (otherwise NETSDK1130).
    -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <!--
      For ConnectionsFile only: the app writes the saved-connections document the plug-in reads at
      connect, and sharing the type is what keeps the two processes agreeing on what matches. This
      is not the forbidden reference - that one is to the *plug-in* (see below), whose re-exported
      activation factory is what once pulled the VPN host into this process.
    -->
    <ProjectReference Include="..\PoiTech.WSSHVpnPlugin.Net\PoiTech.WSSHVpnPlugin.Net.csproj" />
  </ItemGroup>

  <!--
    Deliberately no reference to the plug-in. It ships as its own native DLL, hosted by
    backgroundtaskhost.exe, and this app has never used a type from it - the UI only ever talks to
    the plug-in through VpnManagementAgent, by writing a profile the platform later hands back.

    The reference used to exist so Native AOT would link the component into this executable and
    re-export its DllGetActivationFactory (via UnmanagedEntryPointsAssembly and a /EXPORT linker
    arg). That is what put the VPN host inside a XAML application's process, which is what killed the
    tunnel roughly a minute after every connect. See the plug-in's csproj for the mechanism.
  -->
</Project>