<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Needed even though this project authors no WinRT types: CsWinRT's targets are what strip the
      referenced component's .winmd out of the compile references (otherwise NETSDK1130).
    -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Pulls the WinRT component (and SSH.NET) into the package so the platform can activate
      VpnBackgroundTask. The UI itself only talks to the plug-in through VpnManagementAgent.
    -->
    <ProjectReference Include="..\PoiTech.WSSHVpnPlugin.VpnPlugin\PoiTech.WSSHVpnPlugin.VpnPlugin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The component's CsWinRT source generator emits a [UnmanagedCallersOnly] DllGetActivationFactory.
      Since Native AOT links the component into this executable rather than its own DLL, ILC has to be
      told to keep that entry point and the linker to export it — otherwise the WinRT activation
      registered in the package manifest has nothing to bind to.
    -->
    <UnmanagedEntryPointsAssembly Include="PoiTech.WSSHVpnPlugin.VpnPlugin" />
    <LinkerArg Include="/EXPORT:DllGetActivationFactory" />
  </ItemGroup>
</Project>