<Page
    x:Class="PoiTech.WSSHVpnPlugin.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PoiTech.WSSHVpnPlugin.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="SSH VPN profile"
                   Style="{ThemeResource SubtitleTextBlockStyle}"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Spacing="8" MaxWidth="480" HorizontalAlignment="Left">
            <!--
              Settable because a profile created here does not appear in Settings > Network &
              internet > VPN - only one added through Settings' own "Add VPN" does. To connect the
              sanctioned way, add an entry there first, then name it here so Save writes our custom
              configuration into it.
            -->
            <TextBox x:Name="ProfileNameBox" Header="Profile name" Text="SSH VPN"/>
            <TextBox x:Name="HostBox" Header="SSH server" PlaceholderText="ssh.example.com"/>
            <TextBox x:Name="PortBox" Header="Port" Text="22"/>
            <TextBox x:Name="UserNameBox" Header="User name" PlaceholderText="(leave empty to be prompted)"/>
            <TextBox x:Name="PrivateKeyPathBox" Header="Private key path" PlaceholderText="(leave empty to use a password)"/>
            <TextBox x:Name="FingerprintBox" Header="Host key fingerprint" PlaceholderText="SHA256:..."/>
            <TextBox x:Name="ClientAddressBox" Header="Client IPv4 address" Text="192.168.255.2"/>
            <TextBox x:Name="NetworkAdapterBox" Header="Connect SSH from" PlaceholderText="(leave empty to choose automatically)"/>
            <TextBox x:Name="ExcludeRoutesBox" Header="Keep out of the tunnel (comma separated CIDR)" PlaceholderText="192.168.1.0/24"/>
            <TextBox x:Name="DnsBox" Header="DNS servers (comma separated)" PlaceholderText="1.1.1.1"/>
            <CheckBox x:Name="SpikeProbeCheck" Content="Run M0 diagnostic probes"/>
            <CheckBox x:Name="RemoteTransportCheck" Content="Give the platform a real connection to the SSH server (not loopback)"/>
            <TextBox x:Name="StartDelayBox" Header="Delay before Start, seconds (0 = none; for attaching a debugger)" Text="0"/>
            <CheckBox x:Name="AssignIPv6Check" Content="Assign an IPv6 address and IPv6 routes (fd00::2)"/>
            <CheckBox x:Name="LargeFrameCheck" Content="Use mtu 1500 / maxFrameSize 1512 instead of ours"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,16">
            <Button x:Name="SaveButton" Content="Save profile" Click="OnSaveProfileClick"/>
            <Button x:Name="ConnectButton" Content="Connect" Click="OnConnectClick"/>
            <Button x:Name="DisconnectButton" Content="Disconnect" Click="OnDisconnectClick"/>
            <Button x:Name="DeleteButton" Content="Delete profile" Click="OnDeleteProfileClick"/>
            <Button x:Name="LoopbackButton" Content="Test loopback" Click="OnTestLoopbackClick"/>
            <Button x:Name="CctButton" Content="Test CCT" Click="OnTestCctClick"/>
            <Button x:Name="ListButton" Content="List profiles" Click="OnListProfilesClick"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="StatusText"
                       IsTextSelectionEnabled="True"
                       TextWrapping="Wrap"
                       FontFamily="Consolas"/>
        </ScrollViewer>
    </Grid>
</Page>
