<Page
    x:Class="PoiTech.WSSHVpnPlugin.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PoiTech.WSSHVpnPlugin.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="SSH VPN profile"
                   Style="{ThemeResource SubtitleTextBlockStyle}"
                   Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8" MaxWidth="480" HorizontalAlignment="Left">
            <!--
              Settable because a profile created here does not appear in Settings > Network &
              internet > VPN - only one added through Settings' own "Add VPN" does. To connect the
              sanctioned way, add an entry there first, then name it here so Save writes our custom
              configuration into it.
            -->
            <TextBox x:Name="ProfileNameBox" Header="Profile name" Text="SSH VPN"/>
            <TextBox x:Name="HostBox" Header="SSH server" PlaceholderText="ssh.example.com"/>
            <TextBox x:Name="PortBox" Header="Port" Text="22"/>
            <TextBox x:Name="UserNameBox" Header="User name" PlaceholderText="(leave empty to be prompted)"/>
            <TextBox x:Name="FingerprintBox" Header="Host key fingerprint" PlaceholderText="SHA256:..."/>
            <TextBox x:Name="ClientAddressBox" Header="Client IPv4 address" PlaceholderText="(automatic)"/>
            <TextBox x:Name="ClientIPv6Box" Header="Client IPv6 address (a global address makes Windows prefer IPv6)" PlaceholderText="(automatic)"/>
            <TextBox x:Name="ExcludeRoutesBox" Header="Keep out of the tunnel (comma separated CIDR; ::/0 keeps IPv6 out entirely)" PlaceholderText="192.168.1.0/24"/>
            <TextBox x:Name="DnsBox" Header="DNS servers (comma separated)" PlaceholderText="1.1.1.1"/>
            <TextBox x:Name="KeyFileBox" Header="Private key" IsReadOnly="True" PlaceholderText="(none chosen - a password is used instead)"/>
            <Button x:Name="PickKeyButton" Content="Choose key file..." Click="OnPickKeyClick" HorizontalAlignment="Left"/>
            <TextBox x:Name="MtuBox" Header="MTU (1400 is the documented maximum; higher is faster where the platform accepts it)" Text="1400"/>
            <TextBox x:Name="OpenTimeoutBox" Header="Channel open timeout, seconds (must stay below the 5 s DNS deadline)" Text="3"/>
            <TextBox x:Name="StartDelayBox" Header="Delay before Start, seconds (0 = none; for attaching a debugger)" Text="0"/>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,16">
            <Button x:Name="SaveButton" Content="Save profile" Click="OnSaveProfileClick"/>
            <Button x:Name="ConnectButton" Content="Connect" Click="OnConnectClick"/>
            <Button x:Name="DisconnectButton" Content="Disconnect" Click="OnDisconnectClick"/>
            <Button x:Name="DeleteButton" Content="Delete profile" Click="OnDeleteProfileClick"/>
            <Button x:Name="ListButton" Content="List profiles" Click="OnListProfilesClick"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="220">
            <TextBlock x:Name="StatusText"
                       IsTextSelectionEnabled="True"
                       TextWrapping="Wrap"
                       FontFamily="Consolas"/>
        </ScrollViewer>
    </Grid>
</Page>
